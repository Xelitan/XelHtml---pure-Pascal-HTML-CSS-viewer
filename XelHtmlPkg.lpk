      </Linking>
    </CompilerOptions>
    <Description Value="TXelHtml: HTML + CSS rendering control for building web browsers. Pure Pascal (no browser engine, no OpenSSL/zlib DLLs): HTML parser, CSS cascade with pseudo-classes, flexbox/grid/tables layout, web fonts, images, forms, HTTPS (TlsLib4Pascal), gzip/deflate/br. HTTPS: add package XelHtmlTlsPkg and unit XelHtmlTls to the program."/>
    <License Value="MIT"/>
    <Version Major="1"/>

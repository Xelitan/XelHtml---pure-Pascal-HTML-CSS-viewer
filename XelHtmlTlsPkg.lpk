<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="XelHtmlTlsPkg"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Xelitan.com"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="."/>
        <UnitOutputDirectory Value="lib/xelhtmltlspkg/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="Delphi"/>
        </SyntaxOptions>
      </Parsing>
      <Linking>
        <Debugging>
          <GenerateDebugInfo Value="False"/>
        </Debugging>
      </Linking>
    </CompilerOptions>
    <Description Value="HTTPS for TXelHtml through TlsLib4Pascal (pure Pascal TLS 1.2/1.3). Add the XelHtmlTls unit to the uses clause of the program. Runtime only, because the TlsLib packages are runtime only."/>
    <License Value="MIT"/>
    <Version Major="1"/>
    <Files Count="1">
      <Item1>
        <Filename Value="XelHtmlTls.pas"/>
        <UnitName Value="XelHtmlTls"/>
      </Item1>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="TlsLib.Adapter.FclNet"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
